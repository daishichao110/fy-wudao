/* schedule.wxss - 爱马仕橙 + 翡翠绿 + 洁白空灵主题 */
.container {
  padding: 12px;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* 1. 顶部年级切换 Picker Header */
.header-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 12px 16px;
  margin-bottom: 10px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
  border: 1px solid #f1f5f9;
}

.class-picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.class-title-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.class-label {
  font-size: 13px;
  font-weight: 800;
  color: #0f172a;
}

.picker-pill {
  background: #fff7ed;
  border: 1.5px solid #fed7aa;
  border-radius: 20px;
  padding: 5px 14px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.picker-value {
  font-size: 13px;
  font-weight: 800;
  color: #ea580c;
}

.picker-arrow {
  font-size: 10px;
  color: #ea580c;
}

.filter-tip {
  font-size: 11px;
  font-weight: 700;
  color: #ef4444;
  background: #fef2f2;
  padding: 4px 10px;
  border-radius: 12px;
  border: 1px solid #fecaca;
}

/* 2. 📅 14天滚动日历视图 */
.calendar-wrapper {
  margin-bottom: 12px;
  width: 100%;
  white-space: nowrap;
}

.calendar-scroll {
  display: flex;
  white-space: nowrap;
  padding: 4px 2px 8px;
  gap: 8px;
}

.day-card {
  flex-shrink: 0;
  width: 68px;
  height: 84px;
  border-radius: 16px;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  box-sizing: border-box;
  transition: all 0.2s ease;
  padding: 6px 0;
}

.day-month {
  font-size: 10px;
  font-weight: 700;
  opacity: 0.8;
}

.day-num {
  font-size: 17px;
  font-weight: 800;
  line-height: 1.1;
}

.day-week {
  font-size: 10px;
  font-weight: 700;
  opacity: 0.85;
}

.day-dot-status {
  height: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}

.dot-orange {
  color: #ea580c;
  font-size: 9px;
  font-weight: 800;
}

/* 状态1: 有课卡片 (橙色调、暖底、黑字) */
.has-course {
  background: #fff7ed;
  border: 1.5px solid #fed7aa;
  color: #c2410c;
}

/* 状态2: 无课卡片 (洁白底) */
.no-course {
  background: #ffffff;
  border: 1.5px solid #f1f5f9;
  color: #94a3b8;
}

/* 状态3: 被选中高亮 */
.selected-day {
  background: linear-gradient(135deg, #ea580c 0%, #f97316 100%) !important;
  color: #ffffff !important;
  border: 1.5px solid #ea580c !important;
  box-shadow: 0 6px 16px rgba(234, 88, 12, 0.35);
  transform: translateY(-2px);
}
.selected-day .dot-orange {
  color: #ffffff !important;
}

/* 3. 课程明细卡片 */
.course-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
  border: 1px solid #f1f5f9;
  position: relative;
  overflow: hidden;
}

.left-accent-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 5px;
  height: 100%;
  background: linear-gradient(180deg, #ea580c 0%, #059669 100%);
}

.card-header {
  padding-left: 6px;
}

.time-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.time-tag {
  display: flex;
  align-items: center;
  gap: 4px;
  background: #fff7ed;
  border: 1px solid #fed7aa;
  padding: 3px 8px;
  border-radius: 10px;
}

.time-icon { font-size: 11px; }
.time-text { font-size: 11px; font-weight: 800; color: #ea580c; }

.class-scope-tag {
  font-size: 10px;
  font-weight: 700;
  color: #047857;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  padding: 3px 8px;
  border-radius: 10px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.course-title {
  font-size: 16px;
  font-weight: 800;
  color: #0f172a;
}

.collapse-btn {
  font-size: 11px;
  font-weight: 700;
  color: #ea580c;
}

.meta-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  color: #475569;
  background: #f8fafc;
  padding: 8px 12px;
  border-radius: 12px;
}

.meta-item { display: flex; align-items: center; }

.divider {
  height: 1px;
  background: #f1f5f9;
  margin: 12px 0;
}

.section-sub-title {
  font-size: 12px;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 6px;
  display: block;
}

/* 👗 统一爱马仕橙着装 Pills */
.req-grid-orange, .req-grid-emerald {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.req-pill-orange {
  background: #fff7ed;
  color: #c2410c;
  border: 1px solid #fed7aa;
  font-size: 11px;
  font-weight: 700;
  padding: 5px 10px;
  border-radius: 10px;
}

/* 🎒 统一翡翠绿教具与物品 Pills */
.req-pill-emerald {
  background: #ecfdf5;
  color: #047857;
  border: 1px solid #a7f3d0;
  font-size: 11px;
  font-weight: 700;
  padding: 5px 10px;
  border-radius: 10px;
}

.req-label { font-weight: 800; }

/* 💡 特殊交代 Remark Box */
.remark-box {
  background: #fff7ed;
  border: 1px dashed #fed7aa;
  border-radius: 12px;
  padding: 10px 12px;
  display: flex;
  align-items: flex-start;
  gap: 6px;
}

.remark-icon { font-size: 14px; margin-top: 1px; }
.remark-text { font-size: 11px; color: #c2410c; line-height: 1.5; }
.remark-title { font-weight: 800; color: #ea580c; }

/* 👥 参与学员名单 Box */
.participants-box {
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  border-radius: 12px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.part-title { font-size: 11px; font-weight: 800; color: #047857; }
.part-names { font-size: 12px; font-weight: 600; color: #065f46; line-height: 1.5; }

.empty-box {
  text-align: center;
  padding: 50px 20px;
  background: #ffffff;
  border-radius: 18px;
  border: 1px solid #f1f5f9;
}
.empty-icon { font-size: 40px; display: block; margin-bottom: 8px; }
.empty-text { font-size: 13px; font-weight: 700; color: #94a3b8; }

/* -------------------------------------------------------------
 * 📅 教务排课 Modal 弹窗高级风采样式
 * ------------------------------------------------------------- */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(8px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.modal-card {
  width: 100%;
  max-width: 420px;
  background: #ffffff;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  border: 1px solid #f1f5f9;
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-bottom: 1px solid #fed7aa;
}

.m-title {
  font-size: 15px;
  font-weight: 800;
  color: #c2410c;
}

.close-btn {
  font-size: 16px;
  color: #94a3b8;
  padding: 4px;
}

.modal-body {
  max-height: 65vh;
  padding: 14px 18px;
  box-sizing: border-box;
}

.field-label, .form-label {
  font-size: 12px;
  font-weight: 700;
  color: #334155;
  margin-bottom: 4px;
  display: block;
}

.required {
  color: #ef4444;
  font-weight: 800;
  margin-left: 2px;
}

.fancy-input, .form-input {
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 13px;
  color: #0f172a;
  box-sizing: border-box;
  width: 100%;
}

.fancy-textarea, .form-textarea {
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 13px;
  color: #0f172a;
  width: 100%;
  box-sizing: border-box;
}

.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 13px;
}

.pi-arrow { font-size: 11px; color: #ea580c; }
.form-row-2 { display: flex; gap: 8px; }
.form-row-3 { display: flex; gap: 6px; }
.flex-1 { flex: 1; }
.margin-top-4 { margin-top: 4px; }
.margin-top-6 { margin-top: 6px; }
.margin-top-8 { margin-top: 8px; }
.margin-top-12 { margin-top: 12px; }

.modal-foot {
  padding: 12px 18px;
  border-top: 1px solid #f1f5f9;
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

.act-btn {
  font-size: 13px;
  font-weight: 700;
  padding: 10px 20px;
  border-radius: 12px;
  text-align: center;
}

.btn-reject { background: #f1f5f9; color: #64748b; }
.btn-pass { background: linear-gradient(135deg, #ea580c 0%, #f97316 100%); color: #ffffff; box-shadow: 0 4px 14px rgba(234, 88, 12, 0.3); }
